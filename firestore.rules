    function isValidNonDriverUserChangedFields(docId) {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      return changed.hasOnly(allowedNonDriverUserKeys()) &&
        (!('id' in changed) || next.get('id', docId) == docId) &&
        (!('role' in changed) || next.role in ['user', 'client', 'shipper', 'owner', 'business_shipper', 'agent', 'driver', 'business_driver']) &&
        (!('accountType' in changed) || next.accountType in ['individual', 'business']) &&
        (!('status' in changed) || next.status in ['online', 'offline', 'busy', 'active', 'blocked', 'suspended', 'disabled']) &&
        (!('isOnline' in changed) || isOptionalBool(next, 'isOnline')) &&
        (!('lastSeen' in changed) || isOptionalTimestamp(next, 'lastSeen')) &&
        (!('firstName' in changed) || isOptionalString(next, 'firstName', 0, 80)) &&
        (!('FirstName' in changed) || isOptionalString(next, 'FirstName', 0, 80)) &&
        (!('lastName' in changed) || isOptionalString(next, 'lastName', 0, 80)) &&
        (!('LastName' in changed) || isOptionalString(next, 'LastName', 0, 80)) &&
        (!('username' in changed) || isOptionalString(next, 'username', 0, 80)) &&
        (!('Username' in changed) || isOptionalString(next, 'Username', 0, 80)) &&
        (!('email' in changed) || next.get('email', null) == null || next.get('email', '') == '' || isValidEmail(next.email)) &&
        (!('Email' in changed) || next.get('Email', null) == null || next.get('Email', '') == '' || isValidEmail(next.Email)) &&
        (!('phoneNumber' in changed) || isOptionalString(next, 'phoneNumber', 0, 30)) &&
        (!('PhoneNumber' in changed) || isOptionalString(next, 'PhoneNumber', 0, 30)) &&
        (!('profilePicture' in changed) || next.get('profilePicture', null) == null || next.get('profilePicture', '') == '' || (isValidUrl(next.profilePicture) && next.profilePicture.size() <= 2048)) &&
        (!('ProfilePicture' in changed) || next.get('ProfilePicture', null) == null || next.get('ProfilePicture', '') == '' || (isValidUrl(next.ProfilePicture) && next.ProfilePicture.size() <= 2048)) &&
        (!('gender' in changed) || isOptionalString(next, 'gender', 0, 30)) &&
        (!('dateOfBirth' in changed) || isOptionalString(next, 'dateOfBirth', 0, 30)) &&
        (!('country' in changed) || isOptionalString(next, 'country', 0, 80)) &&
        (!('countryCode' in changed) || isOptionalString(next, 'countryCode', 0, 15)) &&
        (!('allowDataUsage' in changed) || isOptionalBool(next, 'allowDataUsage')) &&
        (!('fcmToken' in changed) || isOptionalString(next, 'fcmToken', 0, 500)) &&
        (!('deviceToken' in changed) || isOptionalString(next, 'deviceToken', 0, 500)) &&
        (!('defaultAddressId' in changed) || isOptionalString(next, 'defaultAddressId', 0, 128)) &&
        (!('notificationPreferences' in changed) || isValidNotificationPreferences(next.notificationPreferences)) &&
        (!('vehicleType' in changed) || isOptionalString(next, 'vehicleType', 0, 80)) &&
        (!('vehicleModel' in changed) || isOptionalString(next, 'vehicleModel', 0, 120)) &&
        (!('licensePlate' in changed) || isOptionalString(next, 'licensePlate', 0, 40)) &&
        (!('currentLocation' in changed) || next.get('currentLocation', null) == null || next.currentLocation is latlng) &&
        (!('companyName' in changed) || isOptionalString(next, 'companyName', 0, 150)) &&
        (!('registrationNumber' in changed) || isOptionalString(next, 'registrationNumber', 0, 80)) &&
        (!('businessRegistrationNumber' in changed) || isOptionalString(next, 'businessRegistrationNumber', 0, 80)) &&
        (!('taxNumber' in changed) || isOptionalString(next, 'taxNumber', 0, 80)) &&
        (!('businessAddress' in changed) || isOptionalString(next, 'businessAddress', 0, 300)) &&
        (!('idDocumentType' in changed) || isOptionalString(next, 'idDocumentType', 0, 50)) &&
        (!('idDocumentName' in changed) || isOptionalString(next, 'idDocumentName', 0, 120)) &&
        (!('idDocumentNumber' in changed) || isOptionalString(next, 'idDocumentNumber', 0, 60)) &&
        (!('idDocumentExpiry' in changed) || isOptionalString(next, 'idDocumentExpiry', 0, 30)) &&
        (!('kycFormSubmitted' in changed) || isOptionalBool(next, 'kycFormSubmitted')) &&
        (!('kybFormSubmitted' in changed) || isOptionalBool(next, 'kybFormSubmitted')) &&
        (!('kycVerified' in changed) || isOptionalBool(next, 'kycVerified')) &&
        (!('kycStatus' in changed) || isOptionalString(next, 'kycStatus', 0, 50)) &&
        (!('kycSessionId' in changed) || isOptionalString(next, 'kycSessionId', 0, 150)) &&
        (!('kycAdminApprovalStatus' in changed) || isOptionalString(next, 'kycAdminApprovalStatus', 0, 50)) &&
        (!('kycAdminApproved' in changed) || isOptionalBool(next, 'kycAdminApproved')) &&
        (!('kybVerified' in changed) || isOptionalBool(next, 'kybVerified')) &&
        (!('kybStatus' in changed) || isOptionalString(next, 'kybStatus', 0, 50)) &&
        (!('kybSessionId' in changed) || isOptionalString(next, 'kybSessionId', 0, 150)) &&
        (!('kybAdminApprovalStatus' in changed) || isOptionalString(next, 'kybAdminApprovalStatus', 0, 50)) &&
        (!('kybAdminApproved' in changed) || isOptionalBool(next, 'kybAdminApproved')) &&
        (!('verificationStatus' in changed) || isOptionalString(next, 'verificationStatus', 0, 50)) &&
        (!('verification_status' in changed) || isOptionalString(next, 'verification_status', 0, 50)) &&
        (!('verificationType' in changed) || next.verificationType in ['none', 'kyc', 'kyb']) &&
        (!('diditRequestId' in changed) || isOptionalString(next, 'diditRequestId', 0, 150)) &&
        (!('diditSessionId' in changed) || isOptionalString(next, 'diditSessionId', 0, 150)) &&
        (!('diditBusinessSessionId' in changed) || isOptionalString(next, 'diditBusinessSessionId', 0, 150)) &&
        (!('diditVendorData' in changed) || isOptionalString(next, 'diditVendorData', 0, 150)) &&
        (!('diditSessionKind' in changed) || isOptionalString(next, 'diditSessionKind', 0, 50)) &&
        (!('diditWebhookType' in changed) || isOptionalString(next, 'diditWebhookType', 0, 100)) &&
        (!('diditStatus' in changed) || isOptionalString(next, 'diditStatus', 0, 50)) &&
        (!('diditVerified' in changed) || isOptionalBool(next, 'diditVerified')) &&
        (!('isVerified' in changed) || isOptionalBool(next, 'isVerified')) &&
        (!('verifiedAt' in changed) || isOptionalTimestampOrDateString(next, 'verifiedAt')) &&
        (!('rejectionReason' in changed) || isOptionalString(next, 'rejectionReason', 0, 500)) &&
        (!('adminApprovalStatus' in changed) || isOptionalString(next, 'adminApprovalStatus', 0, 50)) &&
        (!('adminApproved' in changed) || isOptionalBool(next, 'adminApproved')) &&
        (!('adminRejectionReason' in changed) || isOptionalString(next, 'adminRejectionReason', 0, 500)) &&
        (!('deletionRequested' in changed) || isOptionalBool(next, 'deletionRequested')) &&
        (!('deletionRequestedAt' in changed) || isOptionalTimestamp(next, 'deletionRequestedAt')) &&
        (!('diditUpdatedAt' in changed) || isOptionalTimestamp(next, 'diditUpdatedAt')) &&
        (!('lastUpdated' in changed) || isOptionalTimestamp(next, 'lastUpdated')) &&
        (!('updatedAt' in changed) || isOptionalTimestamp(next, 'updatedAt'));
    }

    function isValidNonDriverDiditChange(prev, next) {
      return (next.get('kycVerified', false) != true || prev.get('kycVerified', false) == true) &&
        (next.get('kybVerified', false) != true || prev.get('kybVerified', false) == true) &&
        (!(next.get('kycStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED']) || (prev.get('kycStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED'])) &&
        (!(next.get('kybStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED']) || (prev.get('kybStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED'])) &&
        (next.get('isVerified', false) != true || prev.get('isVerified', false) == true) &&
        (
          next.get('diditVerified', false) != true ||
          prev.get('diditVerified', false) == true ||
          (next.get('accountType', 'individual') == 'business' && prev.get('kybVerified', false) == true) ||
          (next.get('accountType', 'individual') == 'individual' && prev.get('kycVerified', false) == true)
        ) &&
        (
          !(next.get('verificationStatus', 'unverified') in ['approved', 'Approved', 'APPROVED']) ||
          (prev.get('verificationStatus', 'unverified') in ['approved', 'Approved', 'APPROVED']) ||
          (next.get('accountType', 'individual') == 'business' && prev.get('kybVerified', false) == true) ||
          (next.get('accountType', 'individual') == 'individual' && prev.get('kycVerified', false) == true)
        ) &&
        (
          !(next.get('verification_status', 'unverified') in ['approved', 'Approved', 'APPROVED']) ||
          (prev.get('verification_status', 'unverified') in ['approved', 'Approved', 'APPROVED']) ||
          (next.get('accountType', 'individual') == 'business' && prev.get('kybVerified', false) == true) ||
          (next.get('accountType', 'individual') == 'individual' && prev.get('kycVerified', false) == true)
        ) &&
        (
          !(next.get('diditStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED']) ||
          (prev.get('diditStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED']) ||
          (next.get('accountType', 'individual') == 'business' && prev.get('kybStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED']) ||
          (next.get('accountType', 'individual') == 'individual' && prev.get('kycStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED'])
        );
    }

    function isValidNonDriverAdminApprovalChange(prev, next) {
      let prevKybApproved = prev.get('kybAdminApprovalStatus', 'pending') in ['approved', 'Approved', 'APPROVED'] ||
        prev.get('kybAdminApproved', false) == true;
      let prevKycApproved = prev.get('kycAdminApprovalStatus', 'pending') in ['approved', 'Approved', 'APPROVED'] ||
        prev.get('kycAdminApproved', false) == true;
      return (!(next.get('kycAdminApprovalStatus', 'pending') in ['approved', 'Approved', 'APPROVED']) || prevKycApproved) &&
        (!(next.get('kybAdminApprovalStatus', 'pending') in ['approved', 'Approved', 'APPROVED']) || prevKybApproved) &&
        (next.get('kycAdminApproved', false) != true || prevKycApproved) &&
        (next.get('kybAdminApproved', false) != true || prevKybApproved) &&
        (
          !(next.get('adminApprovalStatus', 'pending') in ['approved', 'Approved', 'APPROVED']) ||
          (prev.get('adminApprovalStatus', 'pending') in ['approved', 'Approved', 'APPROVED']) ||
          (next.get('accountType', 'individual') == 'business' && prevKybApproved) ||
          (next.get('accountType', 'individual') == 'individual' && prevKycApproved)
        ) &&
        (
          next.get('adminApproved', false) != true ||
          prev.get('adminApproved', false) == true ||
          (next.get('accountType', 'individual') == 'business' && prevKybApproved) ||
          (next.get('accountType', 'individual') == 'individual' && prevKycApproved)
        );
    }

    function isValidNonDriverUserUpdateState(docId) {
      let prev = resource.data;
      let next = request.resource.data;
      let changed = next.diff(prev).affectedKeys();
      let adminImmutable = [
        'diditDecision', 'adminApprovalDate', 'adminApprovedAt', 'approvedBy', 'updatedBy',
        'kycAdminApprovalDate', 'kybAdminApprovalDate',
        'kycAdminRejectionReason', 'kybAdminRejectionReason', 'createdAt'
      ];
      let blockedStatuses = ['blocked', 'suspended', 'disabled'];
      return !changed.hasAny(adminImmutable) &&
        (!('id' in changed) || (!('id' in prev) && next.id == docId)) &&
        (
          !('status' in changed) || (
            (!(prev.get('status', 'active') in blockedStatuses) || next.get('status', 'active') == prev.get('status', 'active')) &&
            ((prev.get('status', 'active') in blockedStatuses) || !(next.get('status', 'active') in blockedStatuses))
          )
        ) &&
        (!changed.hasAny(['kycVerified', 'kybVerified', 'kycStatus', 'kybStatus', 'isVerified', 'diditVerified', 'verificationStatus', 'verification_status', 'diditStatus']) || isValidNonDriverDiditChange(prev, next)) &&
        (!changed.hasAny(['kycAdminApprovalStatus', 'kybAdminApprovalStatus', 'kycAdminApproved', 'kybAdminApproved', 'adminApprovalStatus', 'adminApproved']) || isValidNonDriverAdminApprovalChange(prev, next)) &&
        (!('deletionRequested' in changed) || prev.get('deletionRequested', false) != true || next.get('deletionRequested', false) == true);
    }

    function isValidAdminAccountCreate(data, userId) {
      return hasRequiredFields(data, ['id', 'firstName', 'lastName', 'email', 'role']) &&
        data.id == userId &&
        data.keys().hasAny(allowedAdminAccountKeys()) &&
        data.keys().size() <= 35 &&
        isValidString(data.firstName, 1, 80) &&
        isValidString(data.lastName, 1, 80) &&
        isValidEmail(data.email) &&
        isOptionalString(data, 'phoneNumber', 0, 30) &&
        isOptionalString(data, 'username', 0, 100) &&
        data.role in adminRoleList() &&
        isOptionalString(data, 'adminType', 0, 50) &&
        isOptionalString(data, 'adminTypeLabel', 0, 80) &&
        isOptionalBool(data, 'isSuperAdmin') &&
        (!('adminPermissions' in data) || isValidAdminPermissionsMap(data.adminPermissions)) &&
        data.get('status', 'active') in ['active', 'blocked', 'suspended', 'disabled'] &&
        isOptionalString(data, 'createdBy', 0, 160) &&
        isOptionalTimestamp(data, 'createdAt');
    }

    function isValidAdminAccountUpdate(userId) {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      let noSelfLockout = userId != request.auth.uid || (
        !(next.get('status', 'active') in ['blocked', 'suspended', 'disabled']) &&
        isSuperAdminUser(next)
      );
      return noSelfLockout &&
        changed.size() > 0 &&
        (!changed.hasAny(['firstName']) || isValidString(next.firstName, 1, 80)) &&
        (!changed.hasAny(['lastName']) || isValidString(next.lastName, 1, 80)) &&
        (!changed.hasAny(['phoneNumber']) || isOptionalString(next, 'phoneNumber', 0, 30)) &&
        (!changed.hasAny(['role']) || next.role in adminRoleList()) &&
        (!changed.hasAny(['adminType']) || isOptionalString(next, 'adminType', 0, 50)) &&
        (!changed.hasAny(['adminTypeLabel']) || isOptionalString(next, 'adminTypeLabel', 0, 80)) &&
        (!changed.hasAny(['isSuperAdmin']) || next.isSuperAdmin is bool) &&
        (!changed.hasAny(['adminPermissions']) || isValidAdminPermissionsMap(next.adminPermissions)) &&
        (!changed.hasAny(['status']) || next.status in ['active', 'blocked', 'suspended', 'disabled']);
    }

    function isValidAdminUserCreate(data, userId) {
      return !isAdminAccountData(data) &&
        hasOnlyAllowedFields(data, allowedNonDriverUserKeys()) &&
        hasRequiredFields(data, ['id', 'email', 'role']) &&
        data.id == userId &&
        isValidEmail(data.email) &&
        isOptionalString(data, 'firstName', 0, 80) &&
        isOptionalString(data, 'lastName', 0, 80) &&
        isOptionalString(data, 'phoneNumber', 0, 30) &&
        data.role in ['user', 'client', 'shipper', 'owner', 'business_shipper', 'agent', 'driver', 'business_driver'] &&
        data.get('status', 'active') in ['online', 'offline', 'busy', 'active', 'blocked', 'suspended'];
    }

    function isValidAdminUserUpdate() {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      return !isAdminAccountData(resource.data) &&
        !isAdminAccountData(next) &&
        changed.hasOnly(allowedNonDriverUserKeys()) &&
        (!changed.hasAny(['role']) || next.role in ['user', 'client', 'shipper', 'owner', 'business_shipper', 'agent', 'driver', 'business_driver']) &&
        (!changed.hasAny(['status']) || next.status in ['online', 'offline', 'busy', 'active', 'blocked', 'suspended', 'disabled']) &&
        (!changed.hasAny(['adminApprovalStatus']) || next.adminApprovalStatus in ['pending', 'approved', 'rejected']) &&
        (!changed.hasAny(['kycAdminApprovalStatus']) || next.kycAdminApprovalStatus in ['pending', 'approved', 'rejected']) &&
        (!changed.hasAny(['kybAdminApprovalStatus']) || next.kybAdminApprovalStatus in ['pending', 'approved', 'rejected']) &&
        (!changed.hasAny(['adminApproved']) || isOptionalBool(next, 'adminApproved')) &&
        (!changed.hasAny(['adminRejectionReason']) || isOptionalString(next, 'adminRejectionReason', 0, 500)) &&
        (!changed.hasAny(['kycAdminRejectionReason']) || isOptionalString(next, 'kycAdminRejectionReason', 0, 500)) &&
        (!changed.hasAny(['kybAdminRejectionReason']) || isOptionalString(next, 'kybAdminRejectionReason', 0, 500));
    }

    function isValidUserAddress(data) {
      return hasOnlyAllowedFields(data, [
          'id', 'name', 'phoneNumber', 'street', 'city',
          'state', 'postalCode', 'country', 'dateTime'
        ]) &&
        hasRequiredFields(data, ['name', 'street', 'city']) &&
        isOptionalString(data, 'id', 0, 128) &&
        isValidString(data.name, 1, 120) &&
        isOptionalString(data, 'phoneNumber', 0, 30) &&
        isValidString(data.street, 1, 200) &&
        isValidString(data.city, 1, 100) &&
        isOptionalString(data, 'state', 0, 100) &&
        isOptionalString(data, 'postalCode', 0, 30) &&
        isOptionalString(data, 'country', 0, 100) &&
        isOptionalTimestamp(data, 'dateTime');
    }

    function isValidUserNotification(data) {
      return hasOnlyAllowedFields(data, [
          'id', 'title', 'body', 'message', 'type', 'timestamp', 'isRead', 'targetId', 'bookingId', 'createdAt'
        ]) &&
        hasRequiredFields(data, ['title', 'type', 'isRead']) &&
        isOptionalString(data, 'id', 0, 128) &&
        isValidString(data.title, 1, 160) &&
        isOptionalString(data, 'body', 0, 1000) &&
        isOptionalString(data, 'message', 0, 1000) &&
        data.type in [
          'general', 'order', 'booking', 'job', 'payment', 'earnings',
          'promotion', 'security', 'chat', 'system', 'geofence',
          'booking_payment_due', 'booking_paid', 'shipper_refund', 'refund',
          'driver_cancelled_booking', 'kyc', 'kyb', 'verification', 'delivery', 'pod'
        ] &&
        data.isRead is bool &&
        isOptionalString(data, 'targetId', 0, 128) &&
        isOptionalString(data, 'bookingId', 0, 128) &&
        isOptionalTimestampOrDateString(data, 'timestamp') &&
        isOptionalTimestamp(data, 'createdAt');
    }

    // =========================================================================
    // Domain Validators - Fleet, Notifications, Payments, Transactions, Support
    // =========================================================================

    function isValidFleetTruck(data, companyId) {
      return hasOnlyAllowedFields(data, [
          'id', 'companyId', 'truckName', 'licensePlate', 'truckType', 'truckModel',
          'capacity', 'status', 'assignedDriverId', 'assignedDriverName',
          'assignedDriverPhone', 'currentBookingId', 'createdAt', 'updatedAt'
        ]) &&
        hasRequiredFields(data, ['id', 'companyId', 'truckName', 'licensePlate', 'truckType', 'capacity', 'status']) &&
        isValidString(data.id, 1, 128) &&
        data.companyId == companyId &&
        isValidString(data.truckName, 1, 100) &&
        isValidString(data.licensePlate, 1, 40) &&
        isValidString(data.truckType, 1, 80) &&
        isOptionalString(data, 'truckModel', 0, 100) &&
        isValidString(data.capacity, 1, 50) &&
        data.status in ['available', 'on_trip', 'maintenance'] &&
        isOptionalString(data, 'assignedDriverId', 0, 128) &&
        isOptionalString(data, 'assignedDriverName', 0, 100) &&
        isOptionalString(data, 'assignedDriverPhone', 0, 30) &&
        isOptionalString(data, 'currentBookingId', 0, 128) &&
        isOptionalTimestamp(data, 'createdAt') &&
        isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidFleetDriver(data, companyId) {
      return hasOnlyAllowedFields(data, [
          'id', 'companyId', 'fullName', 'phoneNumber', 'licenseNumber', 'licenseClass',
          'status', 'pin', 'assignedTruckId', 'assignedTruckPlate', 'currentBookingId',
          'rating', 'completedTrips', 'createdAt', 'updatedAt'
        ]) &&
        hasRequiredFields(data, ['id', 'companyId', 'fullName', 'phoneNumber', 'status', 'pin']) &&
        isValidString(data.id, 1, 128) &&
        data.companyId == companyId &&
        isValidString(data.fullName, 1, 100) &&
        isValidString(data.phoneNumber, 5, 30) &&
        isOptionalString(data, 'licenseNumber', 0, 50) &&
        isOptionalString(data, 'licenseClass', 0, 100) &&
        data.status in ['available', 'on_trip', 'off_duty'] &&
        isValidString(data.pin, 4, 8) &&
        isOptionalString(data, 'assignedTruckId', 0, 128) &&
        isOptionalString(data, 'assignedTruckPlate', 0, 30) &&
        isOptionalString(data, 'currentBookingId', 0, 128) &&
        isOptionalNum(data, 'rating', 0, 5) &&
        (!('completedTrips' in data) || (data.completedTrips is int && data.completedTrips >= 0)) &&
        isOptionalTimestamp(data, 'createdAt') &&
        isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidNotification(data) {
      return hasOnlyAllowedFields(data, [
          'id', 'title', 'body', 'message', 'type', 'timestamp', 'isRead', 'targetId', 'createdAt'
        ]) &&
        hasRequiredFields(data, ['title', 'message', 'type', 'isRead']) &&
        isOptionalString(data, 'id', 0, 128) &&
        isValidString(data.title, 1, 160) &&
        isOptionalString(data, 'body', 0, 1000) &&
        isValidString(data.message, 1, 1000) &&
        data.type in ['general', 'order', 'booking', 'job', 'payment', 'earnings', 'promotion', 'security', 'chat', 'system', 'geofence'] &&
        data.isRead is bool &&
        isOptionalString(data, 'targetId', 0, 128) &&
        isOptionalTimestampOrDateString(data, 'timestamp') &&
        isOptionalTimestamp(data, 'createdAt');
    }

    function isValidPaymentMethod(data) {
      return hasOnlyAllowedFields(data, [
          'id', 'method', 'mobileNumber', 'maskedNumber', 'network', 'accountName',
          'last4', 'brand', 'expMonth', 'expYear', 'authorizationCode', 'createdAt'
        ]) &&
        hasRequiredFields(data, ['method']) &&
        data.method is map &&
        hasOnlyAllowedFields(data.method, ['id', 'name', 'image', 'code', 'type']) &&
        isOptionalString(data.method, 'id', 0, 128) &&
        isOptionalString(data.method, 'name', 0, 100) &&
        isOptionalString(data.method, 'image', 0, 300) &&
        isOptionalString(data.method, 'code', 0, 40) &&
        isOptionalString(data.method, 'type', 0, 40) &&
        isOptionalString(data, 'id', 0, 128) &&
        isOptionalString(data, 'mobileNumber', 0, 30) &&
        isOptionalString(data, 'maskedNumber', 0, 40) &&
        isOptionalString(data, 'network', 0, 40) &&
        isOptionalString(data, 'accountName', 0, 120) &&
        isOptionalString(data, 'last4', 0, 8) &&
        isOptionalString(data, 'brand', 0, 40) &&
        isOptionalNum(data, 'expMonth', 1, 12) &&
        isOptionalNum(data, 'expYear', 2020, 2100) &&
        isOptionalString(data, 'authorizationCode', 0, 150) &&
        isOptionalTimestampOrDateString(data, 'createdAt');
    }

    function isValidTripEarningsTx(data, txId) {
      return hasOnlyAllowedFields(data, [
          'id', 'bookingId', 'type', 'paymentMethod',
          'grossFare', 'commissionFee', 'netPayout', 'status', 'timestamp', 'createdAtMs'
        ]) &&
        hasRequiredFields(data, ['id', 'bookingId', 'type', 'grossFare', 'commissionFee', 'netPayout', 'status']) &&
        data.id == txId &&
        isValidString(data.bookingId, 1, 128) &&
        data.type == 'trip_earnings' &&
        data.status == 'completed' &&
        isOptionalString(data, 'paymentMethod', 0, 60) &&
        data.grossFare is number && data.grossFare >= 0 && data.grossFare <= 10000000 &&
        data.commissionFee is number && data.commissionFee >= 0 && data.commissionFee <= data.grossFare + 0.05 &&
        data.netPayout is number && data.netPayout >= 0 && data.netPayout <= data.grossFare + 0.05 &&
        (!('createdAtMs' in data) || data.createdAtMs is int) &&
        isOptionalTimestamp(data, 'timestamp');
    }

    function isValidDriverCommissionSettlementTx(data, txId) {
      return hasOnlyAllowedFields(data, [
          'id', 'reference', 'type', 'amount', 'amountGhs',
          'network', 'phone', 'status', 'recordedBy', 'notes',
          'timestamp', 'createdAtMs'
        ]) &&
        hasRequiredFields(data, ['id', 'type', 'amount', 'status']) &&
        data.id == txId &&
        isOptionalString(data, 'reference', 0, 150) &&
        data.type == 'commission_settlement' &&
        data.status == 'success' &&
        data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
        isOptionalNum(data, 'amountGhs', 0, 100000000) &&
        isOptionalString(data, 'network', 0, 60) &&
        isOptionalString(data, 'phone', 0, 40) &&
        isOptionalString(data, 'recordedBy', 0, 60) &&
        isOptionalString(data, 'notes', 0, 1000) &&
        (!('createdAtMs' in data) || data.createdAtMs is int) &&
        isOptionalTimestamp(data, 'timestamp');
    }

    function isValidAdminCommissionSettlementTx(data, txId) {
      return hasOnlyAllowedFields(data, [
          'id', 'reference', 'type', 'amount', 'amountGhs',
          'network', 'phone', 'status', 'recordedBy', 'notes',
          'timestamp', 'createdAtMs'
        ]) &&
        hasRequiredFields(data, ['id', 'reference', 'type', 'amount', 'status', 'recordedBy']) &&
        data.id == txId &&
        isValidString(data.reference, 1, 150) &&
        data.type == 'commission_settlement' &&
        data.status == 'success' &&
        data.recordedBy == 'Admin' &&
        data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
        isOptionalNum(data, 'amountGhs', 0, 100000000) &&
        isOptionalString(data, 'network', 0, 60) &&
        isOptionalString(data, 'phone', 0, 40) &&
        isOptionalString(data, 'notes', 0, 1000) &&
        (!('createdAtMs' in data) || data.createdAtMs is int) &&
        isOptionalTimestamp(data, 'timestamp');
    }

    function isValidAdminCommissionPayment(data, refId) {
      return hasOnlyAllowedFields(data, [
          'userId', 'driverId', 'reference', 'amount', 'usdAmount',
          'type', 'phone', 'network', 'channel', 'status',
          'recordedBy', 'notes', 'createdAt'
        ]) &&
        hasRequiredFields(data, ['userId', 'driverId', 'reference', 'usdAmount', 'type', 'status', 'recordedBy']) &&
        data.reference == refId &&
        isValidString(data.userId, 1, 128) &&
        data.driverId == data.userId &&
        data.type == 'commission_settlement' &&
        data.status == 'success' &&
        data.recordedBy == 'Admin' &&
        data.usdAmount is number && data.usdAmount > 0 && data.usdAmount <= 10000000 &&
        isOptionalNum(data, 'amount', 0, 100000000) &&
        isOptionalString(data, 'phone', 0, 40) &&
        isOptionalString(data, 'network', 0, 60) &&
        isOptionalString(data, 'channel', 0, 60) &&
        isOptionalString(data, 'notes', 0, 1000) &&
        isOptionalTimestamp(data, 'createdAt');
    }

    function isValidCancelledTrip(data, cancelId) {
      return hasOnlyAllowedFields(data, [
          'id', 'bookingId', 'pickupAddress', 'dropoffAddress', 'price',
          'truckType', 'weight', 'distance', 'containerSize',
          'status', 'cancelledAt', 'createdAtMs'
        ]) &&
        hasRequiredFields(data, ['id', 'bookingId', 'status']) &&
        data.id == cancelId &&
        isValidString(data.bookingId, 1, 128) &&
        data.status == 'cancelled' &&
        isOptionalString(data, 'pickupAddress', 0, 300) &&
        isOptionalString(data, 'dropoffAddress', 0, 300) &&
        isOptionalNum(data, 'price', 0, 10000000) &&
        isOptionalString(data, 'truckType', 0, 80) &&
        isOptionalNum(data, 'weight', 0, 1000000) &&
        isOptionalNum(data, 'distance', 0, 100000) &&
        isOptionalString(data, 'containerSize', 0, 40) &&
        (!('createdAtMs' in data) || data.createdAtMs is int) &&
        isOptionalTimestamp(data, 'cancelledAt');
    }

    function isValidAdminCancelledTrip(data) {
      return hasOnlyAllowedFields(data, [
          'bookingId', 'reason', 'cancelledBy', 'timestamp'
        ]) &&
        hasRequiredFields(data, ['bookingId', 'reason', 'cancelledBy']) &&
        isValidString(data.bookingId, 1, 128) &&
        isValidString(data.reason, 0, 1000) &&
        data.cancelledBy == 'Admin' &&
        isOptionalTimestamp(data, 'timestamp');
    }

    function isValidSupportTicket(data) {
      let isDriverTicket = data.get('driverId', '') == request.auth.uid && !('userId' in data);
      let isShipperTicket = data.get('userId', '') == request.auth.uid && !('driverId' in data);
      return hasOnlyAllowedFields(data, [
          'ticketCode', 'driverId', 'driverEmail', 'userId', 'userEmail',
          'category', 'bookingRef', 'subject', 'message', 'status', 'platform', 'createdAt'
        ]) &&
        hasRequiredFields(data, ['ticketCode', 'category', 'subject', 'message', 'status', 'createdAt']) &&
        (isDriverTicket || isShipperTicket) &&
        data.status == 'open' &&
        isValidString(data.ticketCode, 3, 40) &&
        isOptionalString(data, 'driverEmail', 0, 160) &&
        isOptionalString(data, 'userEmail', 0, 160) &&
        isValidString(data.category, 2, 100) &&
        isOptionalString(data, 'bookingRef', 0, 100) &&
        isValidString(data.subject, 2, 200) &&
        isValidString(data.message, 5, 3000) &&
        isOptionalString(data, 'platform', 0, 40) &&
        data.createdAt == request.time;
    }

    function isValidAdminSupportTicketUpdate() {
      let next = request.resource.data;
      return next.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        next.status in ['open', 'in_review', 'resolved'] &&
        isOptionalTimestamp(next, 'updatedAt');
    }

    function isValidAccountDeletionRequest(data) {
      let dPath = /databases/$(database)/documents/drivers/$(request.auth.uid);
      let noPendingCommission = !exists(dPath) || isDocCommissionClear(get(dPath).data);
      let isDriverReq = data.get('driverId', '') == request.auth.uid && !('userId' in data);
      let isShipperReq = data.get('userId', '') == request.auth.uid && !('driverId' in data);
      return hasOnlyAllowedFields(data, [
          'driverId', 'userId', 'email', 'reason', 'notes', 'status', 'requestedAt', 'platform'
        ]) &&
        hasRequiredFields(data, ['reason', 'status', 'requestedAt']) &&
        (isDriverReq || isShipperReq) &&
        data.status in ['pending_review', 'completed'] &&
        noPendingCommission &&
        isOptionalString(data, 'email', 0, 160) &&
        isValidString(data.reason, 2, 200) &&
        isOptionalString(data, 'notes', 0, 1000) &&
        isOptionalString(data, 'platform', 0, 40) &&
        data.requestedAt == request.time;
    }

    function isValidAdminDeletionRequestUpdate() {
      let next = request.resource.data;
      return next.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'notes']) &&
        next.status in ['pending_review', 'approved', 'rejected', 'completed'] &&
        isOptionalString(next, 'reviewedBy', 0, 160) &&
        isOptionalString(next, 'notes', 0, 1000) &&
        isOptionalTimestamp(next, 'reviewedAt');
    }

    function isValidBannerCreate(data) {
      return hasOnlyAllowedFields(data, ['imageUrl', 'targetScreen', 'active']) &&
        hasRequiredFields(data, ['imageUrl', 'targetScreen', 'active']) &&
        isValidUrl(data.imageUrl) &&
        data.imageUrl.size() <= 1000 &&
        isValidString(data.targetScreen, 0, 120) &&
        data.active is bool;
    }

    function isValidBannerUpdate() {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      return changed.hasOnly(['imageUrl', 'targetScreen', 'active']) &&
        (!changed.hasAny(['imageUrl']) || (isValidUrl(next.imageUrl) && next.imageUrl.size() <= 1000)) &&
        (!changed.hasAny(['targetScreen']) || isValidString(next.targetScreen, 0, 120)) &&
        (!changed.hasAny(['active']) || next.active is bool);
    }

    function isValidPricingConfig(data) {
      return hasOnlyAllowedFields(data, [
          'platformCommissionPercent', 'singleTripMultiplier', 'roundTripMultiplier',
          'emptyContainerDiscountPercent', 'container20ftMultiplier', 'container40ftMultiplier',
          'twin20ftMultiplier', 'tareWeight20ftKg', 'tareWeight40ftKg',
          'fragileSurchargePercent', 'hazardousSurchargePercent',
          'truckRates', 'journeyCategories'
        ]) &&
        isOptionalNum(data, 'platformCommissionPercent', 0, 100) &&
        isOptionalNum(data, 'singleTripMultiplier', 0, 10) &&
        isOptionalNum(data, 'roundTripMultiplier', 0, 10) &&
        isOptionalNum(data, 'emptyContainerDiscountPercent', 0, 100) &&
        isOptionalNum(data, 'container20ftMultiplier', 0, 10) &&
        isOptionalNum(data, 'container40ftMultiplier', 0, 10) &&
        isOptionalNum(data, 'twin20ftMultiplier', 0, 10) &&
        isOptionalNum(data, 'tareWeight20ftKg', 0, 100000) &&
        isOptionalNum(data, 'tareWeight40ftKg', 0, 100000) &&
        isOptionalNum(data, 'fragileSurchargePercent', 0, 100) &&
        isOptionalNum(data, 'hazardousSurchargePercent', 0, 100) &&
        (!('truckRates' in data) || (data.truckRates is map && data.truckRates.size() <= 30)) &&
        (!('journeyCategories' in data) || (data.journeyCategories is list && data.journeyCategories.size() <= 20));
    }

    function isValidSupportConfig(data) {
      return hasOnlyAllowedFields(data, [
          'supportEmail', 'supportPhone', 'emergencyNumber',
          'supportHours', 'disputeNotice', 'updatedBy', 'updatedAt'
        ]) &&
        isOptionalString(data, 'supportEmail', 0, 160) &&
        isOptionalString(data, 'supportPhone', 0, 40) &&
        isOptionalString(data, 'emergencyNumber', 0, 40) &&
        isOptionalString(data, 'supportHours', 0, 200) &&
        isOptionalString(data, 'disputeNotice', 0, 1000) &&
        isOptionalString(data, 'updatedBy', 0, 160) &&
        isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidPaystackGatewayConfig(data) {
      let allowedKeys = [
        'isPaystackSandboxMode', 'isSandbox', 'isLive',
        'livePublicKey', 'liveSecretKey', 'testPublicKey', 'testSecretKey',
        'paystackLivePublicKey', 'paystackLiveSecretKey', 'publicKey', 'secretKey',
        'paystackTestPublicKey', 'paystackTestSecretKey', 'updatedAt'
      ];
      return hasOnlyAllowedFields(data, allowedKeys) &&
        isOptionalBool(data, 'isPaystackSandboxMode') &&
        isOptionalBool(data, 'isSandbox') &&
        isOptionalBool(data, 'isLive') &&
        isOptionalString(data, 'livePublicKey', 0, 200) &&
        isOptionalString(data, 'liveSecretKey', 0, 200) &&
        isOptionalString(data, 'testPublicKey', 0, 200) &&
        isOptionalString(data, 'testSecretKey', 0, 200) &&
        isOptionalString(data, 'paystackLivePublicKey', 0, 200) &&
        isOptionalString(data, 'paystackLiveSecretKey', 0, 200) &&
        isOptionalString(data, 'publicKey', 0, 200) &&
        isOptionalString(data, 'secretKey', 0, 200) &&
        isOptionalString(data, 'paystackTestPublicKey', 0, 200) &&
        isOptionalString(data, 'paystackTestSecretKey', 0, 200) &&
        isOptionalTimestamp(data, 'updatedAt');
    }

    // =========================================================================
    // Booking Helpers & Validators
    // =========================================================================

    function isBookingOpenStatus(b) {
      return b.get('status', 'pending') in [
        'pending', 'available', 'open', 'unassigned',
        'Pending', 'Available', 'Open', 'Unassigned',
        'PENDING', 'AVAILABLE'
      ];
    }

    function isBookingUnassigned(b) {
      return isBookingOpenStatus(b) &&
        (b.get('driverId', null) == null || b.get('driverId', '') == '' || b.get('driverId', '') == 'null') &&
        (b.get('driver_id', null) == null || b.get('driver_id', '') == '' || b.get('driver_id', '') == 'null') &&
        (b.get('assignedDriverId', null) == null || b.get('assignedDriverId', '') == '' || b.get('assignedDriverId', '') == 'null') &&
        (b.get('companyId', null) == null || b.get('companyId', '') == '' || b.get('companyId', '') == 'null');
    }

    function isAssignedDriverOrCompany(b) {
      return isAuthenticated() && (
        b.get('driverId', '') == request.auth.uid ||
        b.get('driver_id', '') == request.auth.uid ||
        b.get('companyId', '') == request.auth.uid ||
        b.get('assignedDriverId', '') == request.auth.uid
      );
    }

    function allowedShipperBookingKeys() {
      return [
        'id', 'userId', 'bookingId', 'cargoType', 'containerSize', 'containerStatus',
        'loadDescription', 'senderName', 'senderPhone', 'receiverName', 'receiverPhone',
        'status', 'timestamp', 'documents', 'truckType', 'price',
        'pickupAddress', 'dropoffAddress', 'weight', 'distance',
        'pickupLocation', 'dropoffLocation',
        'pickupLat', 'pickupLng', 'dropoffLat', 'dropoffLng',
        'pickup_lat', 'pickup_lng', 'dropoff_lat', 'dropoff_lng',
        'pickup_location', 'dropoff_location',
        'isFragile', 'isInsured', 'requiresLoadingAssistance', 'isHazardous',
        'tripType', 'roundTripLegMode', 'journeyCategory',
        'containerDeckSurcharge', 'emptyReturnDiscount', 'excessWeightFee',
        'specialSurcharges', 'roadAllowance', 'overnightAllowance', 'fragileBonus',
        'loadingLaborFee', 'driverEarnings', 'platformFee', 'currency',
        'scheduledDate', 'cargoValue', 'paymentMethod', 'initialPaymentMethod',
        'paymentStatus', 'paidOnline', 'paymentReference', 'paymentChannel',
        'paymentNetwork', 'paymentPhone', 'paidAmountGhs', 'paidAmountUsd',
        'paidByUserId', 'paidAt', 'driverPayoutStatus',
        'driverId', 'driver_id', 'assignedDriverId', 'assignedTruckId',
        'companyId', 'companyName', 'driverName', 'driverPhone',
        'driverImage', 'driverProfilePicture', 'driverPhotoUrl',
        'vehiclePlate', 'vehicleModel', 'driverRating',
        'driverLocation', 'driverHeading', 'driverBearing', 'lastUpdated',
        'chatSessionId', 'inventory', 'stops', 'updatedAt', 'createdAt', 'createdAtMs',
        'completedAt', 'cancelledAt', 'commissionFee', 'platformCommissionPercent',
        'driverNetPayout', 'driverPayout',
        // Preserved server/driver audit fields when editing an existing released pending booking
        'lastDriverCancelledAt', 'driverCancellationCount', 'driver',
        'refundStatus', 'refundReference', 'refundAmountUsd', 'refundAmountGhs',
        'refundMethod', 'refundAccount', 'refundAccountName', 'refundFailureReason', 'refundedAt'
      ];
    }

    function isValidShipperBookingPayload(data) {
      return hasOnlyAllowedFields(data, allowedShipperBookingKeys()) &&
        data.get('userId', '') == request.auth.uid &&
        data.get('status', '') is string &&
        isOptionalString(data, 'bookingId', 0, 128) &&
        isOptionalString(data, 'cargoType', 0, 150) &&
        isOptionalString(data, 'loadDescription', 0, 4000) &&
        isOptionalString(data, 'senderName', 0, 200) &&
        isOptionalString(data, 'senderPhone', 0, 80) &&
        isOptionalString(data, 'receiverName', 0, 200) &&
        isOptionalString(data, 'receiverPhone', 0, 80) &&
        isOptionalString(data, 'truckType', 0, 150) &&
        isOptionalString(data, 'pickupAddress', 0, 1000) &&
        isOptionalString(data, 'dropoffAddress', 0, 1000) &&
        isOptionalNum(data, 'price', 0, 100000000) &&
        isOptionalNum(data, 'distance', 0, 1000000) &&
        isOptionalNum(data, 'weight', 0, 10000000) &&
        (!('documents' in data) || data.documents == null || (data.documents is list && data.documents.size() <= 50)) &&
        (!('inventory' in data) || data.inventory == null || (data.inventory is list && data.inventory.size() <= 100)) &&
        (!('stops' in data) || data.stops == null || (data.stops is list && data.stops.size() <= 30));
    }

    function isValidShipperBookingCreate(data) {
      return isValidShipperBookingPayload(data) &&
        data.get('status', 'pending') in ['pending', 'Pending', 'PENDING'] &&
        data.get('paidOnline', false) == false &&
        data.get('paymentStatus', 'unpaid') in ['unpaid', 'Unpaid', 'UNPAID', 'pending', 'Pending', ''] &&
        (data.get('paymentReference', null) == null || data.get('paymentReference', '') == '') &&
        (data.get('paidAt', null) == null || data.get('paidAt', '') == '') &&
        (data.get('paidAmountGhs', null) == null || data.get('paidAmountGhs', 0) == 0) &&
        (data.get('paidAmountUsd', null) == null || data.get('paidAmountUsd', 0) == 0) &&
        (data.get('paidByUserId', null) == null || data.get('paidByUserId', '') == '') &&
        (data.get('driverPayoutStatus', null) == null || data.get('driverPayoutStatus', '') in ['', 'pending_delivery']) &&
        (data.get('refundStatus', null) == null || data.get('refundStatus', '') in ['', 'none']) &&
        (data.get('refundReference', null) == null || data.get('refundReference', '') == '') &&
        (data.get('refundedAt', null) == null || data.get('refundedAt', '') == '') &&
        (data.get('chatSessionId', null) == null || data.get('chatSessionId', '') == '') &&
        (data.get('driverId', null) == null || data.get('driverId', '') == '') &&
        (data.get('assignedDriverId', null) == null || data.get('assignedDriverId', '') == '') &&
        (data.get('companyId', null) == null || data.get('companyId', '') == '');
    }

    function isValidShipperBookingEdit() {
      let prev = resource.data;
      let next = request.resource.data;
      return prev.get('userId', '') == request.auth.uid &&
        next.get('userId', '') == request.auth.uid &&
        (isEligibleVerifiedShipper() || isAdmin()) &&
        isBookingOpenStatus(prev) &&
        (prev.get('driverId', null) == null || prev.get('driverId', '') == '' || prev.get('driverId', '') == 'null') &&
        (prev.get('companyId', null) == null || prev.get('companyId', '') == '' || prev.get('companyId', '') == 'null') &&
        prev.get('paidOnline', false) == false &&
        next.get('paidOnline', false) == false &&
        isBookingOpenStatus(next) &&
        (next.get('driverId', null) == null || next.get('driverId', '') == '') &&
        (next.get('driver_id', null) == null || next.get('driver_id', '') == '') &&
        (next.get('assignedDriverId', null) == null || next.get('assignedDriverId', '') == '') &&
        (next.get('companyId', null) == null || next.get('companyId', '') == '') &&
        (next.get('paymentReference', null) == null || next.get('paymentReference', '') == '') &&
        (next.get('paidAmountGhs', null) == null || next.get('paidAmountGhs', 0) == 0) &&
        (next.get('paidAmountUsd', null) == null || next.get('paidAmountUsd', 0) == 0) &&
        (next.get('paidByUserId', null) == null || next.get('paidByUserId', '') == '') &&
        isOptionalString(next, 'bookingId', 0, 128) &&
        isOptionalString(next, 'cargoType', 0, 150) &&
        isOptionalString(next, 'loadDescription', 0, 4000) &&
        isOptionalString(next, 'senderName', 0, 200) &&
        isOptionalString(next, 'senderPhone', 0, 80) &&
        isOptionalString(next, 'receiverName', 0, 200) &&
        isOptionalString(next, 'receiverPhone', 0, 80) &&
        isOptionalString(next, 'truckType', 0, 150) &&
        isOptionalString(next, 'pickupAddress', 0, 1000) &&
        isOptionalString(next, 'dropoffAddress', 0, 1000) &&
        isOptionalNum(next, 'price', 0, 100000000) &&
        isOptionalNum(next, 'distance', 0, 1000000) &&
        isOptionalNum(next, 'weight', 0, 10000000) &&
        (!('documents' in next) || next.documents == null || (next.documents is list && next.documents.size() <= 50)) &&
        (!('inventory' in next) || next.inventory == null || (next.inventory is list && next.inventory.size() <= 100)) &&
        (!('stops' in next) || next.stops == null || (next.stops is list && next.stops.size() <= 30));
    }

    function isValidShipperBookingDocumentsUpdate() {
      let prev = resource.data;
      let next = request.resource.data;
      return prev.get('userId', '') == request.auth.uid &&
        !(prev.get('status', 'pending') in ['delivered', 'completed', 'cancelled', 'canceled']) &&
        next.diff(prev).affectedKeys().hasOnly(['documents', 'updatedAt']) &&
        next.documents is list &&
        next.documents.size() <= 20 &&
        isOptionalTimestamp(next, 'updatedAt');
    }

    function isValidShipperBookingCancel() {
      let prev = resource.data;
      let next = request.resource.data;
      return prev.get('userId', '') == request.auth.uid &&
        prev.get('status', 'pending') in [
          'pending', 'available', 'open', 'unassigned',
          'Pending', 'Available', 'Open', 'Unassigned',
          'confirmed', 'Confirmed', 'accepted', 'assigned',
          'onTheWayToPickup', 'onthewaytopickup'
        ] &&
        next.get('status', '') in ['cancelled', 'canceled'] &&
        next.diff(prev).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        isOptionalTimestamp(next, 'updatedAt');
    }

    function isValidShipperBookingPaymentMirror(bookingId) {
      let prev = resource.data;
      let next = request.resource.data;
      let payRef = next.get('paymentReference', '');
      let pPath = /databases/$(database)/documents/Payments/$(payRef);
      let paymentDocValid = payRef is string &&
        payRef.size() > 0 &&
        payRef.size() <= 150 &&
        exists(pPath) &&
        get(pPath).data.get('status', '') == 'success' &&
        get(pPath).data.get('userId', '') == request.auth.uid &&
        get(pPath).data.get('bookingId', '') == bookingId;
      let alreadySettledSameRef =
        prev.get('paidOnline', false) == true &&
        prev.get('paymentStatus', '') == 'paid' &&
        payRef == prev.get('paymentReference', '');

      return prev.get('userId', '') == request.auth.uid &&
        next.diff(prev).affectedKeys().hasOnly([
          'paymentMethod', 'paymentStatus', 'paidOnline', 'paymentReference',
          'paymentChannel', 'paymentNetwork', 'paymentPhone',
          'paidAmountGhs', 'paidAmountUsd', 'paidByUserId', 'paidAt', 'updatedAt'
        ]) &&
        next.get('paidOnline', false) == true &&
        next.get('paymentStatus', '') == 'paid' &&
        next.get('paidByUserId', request.auth.uid) == request.auth.uid &&
        isOptionalString(next, 'paymentMethod', 1, 80) &&
        isOptionalString(next, 'paymentChannel', 0, 50) &&
        isOptionalString(next, 'paymentNetwork', 0, 50) &&
        isOptionalString(next, 'paymentPhone', 0, 30) &&
        isOptionalNum(next, 'paidAmountGhs', 0, 100000000) &&
        isOptionalNum(next, 'paidAmountUsd', 0, 10000000) &&
        isOptionalTimestampOrDateString(next, 'paidAt') &&
        isOptionalTimestamp(next, 'updatedAt') &&
        (alreadySettledSameRef || paymentDocValid);
    }

    function isValidBookingAcceptance() {
      let prev = resource.data;
      let next = request.resource.data;
      let allowedChanged = [
        'status', 'driverId', 'driver_id', 'assignedDriverId',
        'driverName', 'driverPhone', 'driverImage', 'driverProfilePicture',
        'vehiclePlate', 'vehicleModel', 'truckType',
        'companyId', 'companyName', 'assignedTruckId',
        'driverRating', 'chatSessionId',
        'driverLocation', 'driverHeading', 'driverBearing', 'lastUpdated', 'updatedAt'
      ];
      return isBookingUnassigned(prev) &&
        isEligibleVerifiedDriver() &&
        next.diff(prev).affectedKeys().hasOnly(allowedChanged) &&
        next.get('status', '') in ['confirmed', 'Confirmed'] &&
        next.get('driverId', '') == request.auth.uid &&
        next.get('driver_id', request.auth.uid) == request.auth.uid &&
        isOptionalString(next, 'driverName', 0, 120) &&
        isOptionalString(next, 'driverPhone', 0, 50) &&
        isOptionalString(next, 'driverImage', 0, 2048) &&
        isOptionalString(next, 'driverProfilePicture', 0, 2048) &&
        isOptionalString(next, 'vehiclePlate', 0, 50) &&
        isOptionalString(next, 'vehicleModel', 0, 120) &&
        isOptionalString(next, 'truckType', 0, 100) &&
        (!('companyId' in next) || next.companyId == null || next.companyId == '' || next.companyId == request.auth.uid) &&
        isOptionalString(next, 'companyName', 0, 150) &&
        isOptionalString(next, 'assignedTruckId', 0, 128) &&
        isOptionalString(next, 'assignedDriverId', 0, 128) &&
        isOptionalNum(next, 'driverRating', 0, 5) &&
        isOptionalString(next, 'chatSessionId', 0, 160) &&
        isOptionalTimestamp(next, 'updatedAt');
    }

    function isValidBookingLocationUpdate() {
      let prev = resource.data;
      let next = request.resource.data;
      return isAssignedDriverOrCompany(prev) &&
        prev.status in [
          'confirmed', 'Confirmed', 'onTheWayToPickup', 'onthewaytopickup',
          'arrivedPickup', 'arrived_pickup', 'pickedUp', 'picked_up',
          'inTransit', 'intransit', 'in_transit'
        ] &&
        next.diff(prev).affectedKeys().hasOnly(['driverLocation', 'driverHeading', 'driverBearing', 'lastUpdated', 'updatedAt']) &&
        (!('driverLocation' in next) || next.driverLocation == null || next.driverLocation is latlng) &&
        isOptionalNum(next, 'driverHeading', -360, 360) &&
        isOptionalNum(next, 'driverBearing', -360, 360) &&
        isOptionalTimestamp(next, 'lastUpdated') &&
        isOptionalTimestamp(next, 'updatedAt');
    }

    // Geofence / KM Proximity Helpers (default 500m = 0.5 km radius around pickup/dropoff)
    function isGeoWithinRadiusKm(driverLoc, targetLat, targetLng, maxKm) {
      let dLat = driverLoc.latitude() - targetLat;
      let dLon = driverLoc.longitude() - targetLng;
      let midLatRad = ((driverLoc.latitude() + targetLat) / 2.0) * 0.0174532925;
      let x2 = midLatRad * midLatRad;
      let cosLat = 1.0 - (x2 / 2.0) + ((x2 * x2) / 24.0);
      let kmLat = dLat * 111.132;
      let kmLon = dLon * 111.320 * cosLat;
      return (kmLat * kmLat + kmLon * kmLon) <= (maxKm * maxKm);
    }

    function isDriverNearCoordinates(driverLoc, targetLat, targetLng, maxKm) {
      return driverLoc is latlng &&
        targetLat is number &&
        targetLng is number &&
        targetLat >= -90 && targetLat <= 90 &&
        targetLng >= -180 && targetLng <= 180 &&
        !(targetLat == 0 && targetLng == 0) &&
        isGeoWithinRadiusKm(driverLoc, targetLat, targetLng, maxKm);
    }

    function isDriverNearPickup(driverLoc, b, maxKm) {
      return (
        ('pickupLocation' in b && b.pickupLocation is latlng &&
          isDriverNearCoordinates(driverLoc, b.pickupLocation.latitude(), b.pickupLocation.longitude(), maxKm)) ||
        ('pickupLocation' in b && b.pickupLocation is map &&
          isDriverNearCoordinates(driverLoc, b.pickupLocation.get('latitude', b.pickupLocation.get('lat', 0)), b.pickupLocation.get('longitude', b.pickupLocation.get('lng', 0)), maxKm)) ||
        ('pickup_location' in b && b.pickup_location is latlng &&
          isDriverNearCoordinates(driverLoc, b.pickup_location.latitude(), b.pickup_location.longitude(), maxKm)) ||
        ('pickup_location' in b && b.pickup_location is map &&
          isDriverNearCoordinates(driverLoc, b.pickup_location.get('latitude', b.pickup_location.get('lat', 0)), b.pickup_location.get('longitude', b.pickup_location.get('lng', 0)), maxKm)) ||
        (('pickupLat' in b && 'pickupLng' in b) &&
          isDriverNearCoordinates(driverLoc, b.pickupLat, b.pickupLng, maxKm)) ||
        (('pickup_lat' in b && 'pickup_lng' in b) &&
          isDriverNearCoordinates(driverLoc, b.pickup_lat, b.pickup_lng, maxKm))
      );
    }

    function isDriverNearDropoff(driverLoc, b, maxKm) {
      return (
        ('dropoffLocation' in b && b.dropoffLocation is latlng &&
          isDriverNearCoordinates(driverLoc, b.dropoffLocation.latitude(), b.dropoffLocation.longitude(), maxKm)) ||
        ('dropoffLocation' in b && b.dropoffLocation is map &&
          isDriverNearCoordinates(driverLoc, b.dropoffLocation.get('latitude', b.dropoffLocation.get('lat', 0)), b.dropoffLocation.get('longitude', b.dropoffLocation.get('lng', 0)), maxKm)) ||
        ('dropoff_location' in b && b.dropoff_location is latlng &&
          isDriverNearCoordinates(driverLoc, b.dropoff_location.latitude(), b.dropoff_location.longitude(), maxKm)) ||
        ('dropoff_location' in b && b.dropoff_location is map &&
          isDriverNearCoordinates(driverLoc, b.dropoff_location.get('latitude', b.dropoff_location.get('lat', 0)), b.dropoff_location.get('longitude', b.dropoff_location.get('lng', 0)), maxKm)) ||
        (('dropoffLat' in b && 'dropoffLng' in b) &&
          isDriverNearCoordinates(driverLoc, b.dropoffLat, b.dropoffLng, maxKm)) ||
        (('dropoff_lat' in b && 'dropoff_lng' in b) &&
          isDriverNearCoordinates(driverLoc, b.dropoff_lat, b.dropoff_lng, maxKm))
      );
    }

    function getDriverLocForBooking(prev, next) {
      let dPath = /databases/$(database)/documents/drivers/$(request.auth.uid);
      return ('driverLocation' in next && next.driverLocation is latlng)
        ? next.driverLocation
        : (('driverLocation' in prev && prev.driverLocation is latlng)
            ? prev.driverLocation
            : (exists(dPath) ? get(dPath).data.get('currentLocation', null) : null));
    }

    function isOptionalStageLocationValid(prev, next) {
      let changed = next.diff(prev).affectedKeys();
      return (!changed.hasAny(['driverLocation']) || next.driverLocation is latlng) &&
        (!changed.hasAny(['driverHeading']) || (next.driverHeading is number && next.driverHeading >= -360 && next.driverHeading <= 360)) &&
        (!changed.hasAny(['driverBearing']) || (next.driverBearing is number && next.driverBearing >= -360 && next.driverBearing <= 360)) &&
        isOptionalTimestamp(next, 'lastUpdated');
    }

    function getBookingPrice(b) {
      let raw = b.get('price', b.get('amount', b.get('totalPrice', b.get('grossFare', b.get('fare', b.get('total', 0))))));
      return raw is number ? raw : 10000000;
    }

    function isValidGeofenceConfig(data) {
      return hasOnlyAllowedFields(data, [
          'pickupRadiusMeters', 'dropoffRadiusMeters', 'updatedAt', 'updatedBy'
        ]) &&
        (!('pickupRadiusMeters' in data) || (data.pickupRadiusMeters is number && data.pickupRadiusMeters >= 50 && data.pickupRadiusMeters <= 5000)) &&
        (!('dropoffRadiusMeters' in data) || (data.dropoffRadiusMeters is number && data.dropoffRadiusMeters >= 50 && data.dropoffRadiusMeters <= 5000)) &&
        isOptionalString(data, 'updatedBy', 0, 128) &&
        isOptionalTimestamp(data, 'updatedAt');
    }

    function getGeofenceRadiusKm(fieldName) {
      let cfgPath = /databases/$(database)/documents/app_settings/geofence_config;
      let rawMeters = exists(cfgPath) ? get(cfgPath).data.get(fieldName, 500.0) : 500.0;
      let safeMeters = (rawMeters is number && rawMeters >= 50 && rawMeters <= 5000) ? rawMeters : 500.0;
      return safeMeters / 1000.0;
    }

    function isValidDeliveryTransition(prev, next, driverLoc) {
      let prevPrice = getBookingPrice(prev);
      let commFee = next.get('commissionFee', 0);
      let netPay = next.get('driverNetPayout', next.get('driverPayout', 0));
      let isPaidOnline = prev.get('paidOnline', false) == true || prev.get('paymentStatus', 'unpaid') == 'paid';

      return prev.status in ['inTransit', 'intransit', 'in_transit', 'pickedUp', 'picked_up'] &&
        next.status in ['delivered', 'completed'] &&
        isDriverNearDropoff(driverLoc, prev, getGeofenceRadiusKm('dropoffRadiusMeters')) &&
        next.diff(prev).affectedKeys().hasOnly([
          'status', 'completedAt', 'updatedAt',
          'driverLocation', 'driverHeading', 'driverBearing', 'lastUpdated',
          'journeyCategory', 'commissionFee', 'platformFee',
          'platformCommissionPercent', 'driverNetPayout', 'driverPayout', 'driverPayoutStatus'
        ]) &&
        isOptionalString(next, 'journeyCategory', 0, 120) &&
        commFee is number && commFee >= 0 && commFee <= prevPrice + 0.05 &&
        netPay is number && netPay >= 0 && (commFee + netPay) <= prevPrice + 0.05 &&
        isOptionalNum(next, 'platformFee', 0, prevPrice + 0.05) &&
        isOptionalNum(next, 'platformCommissionPercent', 0, 100) &&
        isOptionalNum(next, 'driverPayout', 0, prevPrice + 0.05) &&
        (!('driverPayoutStatus' in next) || (isPaidOnline && next.driverPayoutStatus == 'ready_for_payout')) &&
        isOptionalTimestamp(next, 'completedAt');
    }

    function isValidSequentialStageTransition() {
      let prev = resource.data;
      let next = request.resource.data;
      let sPrev = prev.status;
      let sNext = next.status;
      let driverLoc = getDriverLocForBooking(prev, next);

      let toPickup =
        sPrev in ['confirmed', 'Confirmed'] &&
        sNext in ['onTheWayToPickup', 'onthewaytopickup', 'arrivedPickup', 'arrived_pickup'] &&
        isDriverNearPickup(driverLoc, prev, getGeofenceRadiusKm('pickupRadiusMeters')) &&
        next.diff(prev).affectedKeys().hasOnly([
          'status', 'updatedAt', 'driverLocation', 'driverHeading', 'driverBearing', 'lastUpdated'
        ]);

      let toTransit =
        sPrev in ['onTheWayToPickup', 'onthewaytopickup', 'arrivedPickup', 'arrived_pickup'] &&
        sNext in ['inTransit', 'intransit', 'in_transit', 'pickedUp', 'picked_up'] &&
        isDriverNearPickup(driverLoc, prev, getGeofenceRadiusKm('pickupRadiusMeters')) &&
        next.diff(prev).affectedKeys().hasOnly([
          'status', 'updatedAt', 'driverLocation', 'driverHeading', 'driverBearing', 'lastUpdated'
        ]);

      return isAssignedDriverOrCompany(prev) &&
        isOptionalTimestamp(next, 'updatedAt') &&
        isOptionalStageLocationValid(prev, next) &&
        (toPickup || toTransit || isValidDeliveryTransition(prev, next, driverLoc));
    }

    function isValidDriverCancellation() {
      let prev = resource.data;
      let next = request.resource.data;
      let releaseFields = [
        'status', 'driverId', 'driver_id', 'assignedDriverId', 'assignedTruckId',
        'companyId', 'companyName', 'driver', 'driverName', 'driverPhone',
        'driverImage', 'driverProfilePicture',
        'vehiclePlate', 'vehicleModel', 'driverRating', 'chatSessionId',
        'lastDriverCancelledAt', 'driverCancellationCount', 'updatedAt'
      ];
      let isSoloOrCompanyOwner =
        prev.get('driverId', '') == request.auth.uid ||
        prev.get('driver_id', '') == request.auth.uid ||
        prev.get('companyId', '') == request.auth.uid;

      return isAuthenticated() &&
        isSoloOrCompanyOwner &&
        prev.status in [
          'confirmed', 'Confirmed', 'onTheWayToPickup', 'onthewaytopickup',
          'arrivedPickup', 'arrived_pickup', 'pickedUp', 'picked_up',
          'inTransit', 'intransit', 'in_transit'
        ] &&
        next.diff(prev).affectedKeys().hasOnly(releaseFields) &&
        next.status == 'pending' &&
        (!('driverId' in next) || next.driverId == null || next.driverId == '') &&
        (!('driver_id' in next) || next.driver_id == null || next.driver_id == '') &&
        (!('assignedDriverId' in next) || next.assignedDriverId == null || next.assignedDriverId == '') &&
        (!('assignedTruckId' in next) || next.assignedTruckId == null || next.assignedTruckId == '') &&
        (!('companyId' in next) || next.companyId == null || next.companyId == '') &&
        (!('chatSessionId' in next) || next.chatSessionId == null || next.chatSessionId == '');
    }

    function isValidAdminBookingUpdate() {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'status', 'driverId', 'driverName', 'driverPhone',
          'driverImage', 'driverProfilePicture',
          'vehiclePlate', 'vehicleModel', 'driverRating',
          'completedAt', 'updatedAt'
        ]) &&
        (!changed.hasAny(['status']) || (
          next.status is string &&
          next.status in [
            'pending', 'confirmed', 'accepted', 'assigned',
            'onTheWayToPickup', 'onthewaytopickup', 'arrivedPickup', 'arrived_pickup',
            'pickedUp', 'picked_up', 'inTransit', 'intransit', 'in_transit',
            'arrived', 'delivered', 'completed', 'cancelled', 'canceled'
          ]
        )) &&
        (!changed.hasAny(['driverId']) || isOptionalString(next, 'driverId', 0, 128)) &&
        (!changed.hasAny(['driverName']) || isOptionalString(next, 'driverName', 0, 120)) &&
        (!changed.hasAny(['driverPhone']) || isOptionalString(next, 'driverPhone', 0, 30)) &&
        (!changed.hasAny(['driverImage']) || isOptionalString(next, 'driverImage', 0, 2048)) &&
        (!changed.hasAny(['driverProfilePicture']) || isOptionalString(next, 'driverProfilePicture', 0, 2048)) &&
        (!changed.hasAny(['vehiclePlate']) || isOptionalString(next, 'vehiclePlate', 0, 30)) &&
        (!changed.hasAny(['vehicleModel']) || isOptionalString(next, 'vehicleModel', 0, 100)) &&
        (!changed.hasAny(['driverRating']) || isOptionalNum(next, 'driverRating', 0, 5)) &&
        (!changed.hasAny(['completedAt']) || isOptionalTimestamp(next, 'completedAt')) &&
        (!changed.hasAny(['updatedAt']) || isOptionalTimestamp(next, 'updatedAt'));
    }

    // Chat Helpers
    function isBookingParticipant(bookingId) {
      let bPath = /databases/$(database)/documents/bookings/$(bookingId);
      return isAuthenticated() &&
        exists(bPath) &&
        (
          get(bPath).data.get('userId', '') == request.auth.uid ||
          get(bPath).data.get('driverId', '') == request.auth.uid ||
          get(bPath).data.get('driver_id', '') == request.auth.uid ||
          get(bPath).data.get('companyId', '') == request.auth.uid ||
          get(bPath).data.get('assignedDriverId', '') == request.auth.uid
        );
    }

    function isBookingChatUnlocked(bookingId) {
      let bPath = /databases/$(database)/documents/bookings/$(bookingId);
      return exists(bPath) &&
        !(get(bPath).data.get('status', 'pending') in [
          'pending', 'Pending', 'PENDING',
          'available', 'Available', 'AVAILABLE',
          'open', 'Open', 'OPEN',
          'unassigned', 'Unassigned', 'UNASSIGNED',
          'delivered', 'Delivered', 'DELIVERED',
          'completed', 'Completed', 'COMPLETED',
          'cancelled', 'Cancelled', 'CANCELLED',
          'canceled', 'Canceled', 'CANCELED',
          'rejected', 'Rejected', 'REJECTED',
          'expired', 'Expired', 'EXPIRED'
        ]);
    }

    function isValidChatMessageCreate(data) {
      return hasOnlyAllowedFields(data, [
          'senderId', 'chatSessionId', 'senderName', 'senderRole',
          'type', 'text', 'audioUrl', 'audioBase64', 'imageUrl', 'imageBase64',
          'lat', 'lng', 'duration', 'durationSeconds',
          'status', 'isSeen', 'isDelivered', 'isEdited', 'editedAt', 'seenAt',
          'timestamp', 'createdAtMs',
          'replyToId', 'replyToText', 'replyToSenderName'
        ]) &&
        hasRequiredFields(data, ['senderId', 'senderRole', 'type', 'text', 'status', 'isSeen']) &&
        data.senderId == request.auth.uid &&
        data.senderRole in ['driver', 'business_driver', 'user', 'shipper', 'business_shipper', 'agent'] &&
        data.type in ['text', 'audio', 'image', 'location'] &&
        isValidString(data.text, 1, 2000) &&
        isOptionalString(data, 'chatSessionId', 0, 160) &&
        isOptionalString(data, 'senderName', 0, 120) &&
        isOptionalString(data, 'audioUrl', 0, 1000) &&
        isOptionalString(data, 'audioBase64', 0, 900000) &&
        isOptionalString(data, 'imageUrl', 0, 1000) &&
        isOptionalString(data, 'imageBase64', 0, 900000) &&
        isOptionalNum(data, 'lat', -90, 90) &&
        isOptionalNum(data, 'lng', -180, 180) &&
        isOptionalString(data, 'duration', 0, 20) &&
        isOptionalNum(data, 'durationSeconds', 0, 600) &&
        data.status in ['sent', 'delivered'] &&
        data.isSeen == false &&
        isOptionalBool(data, 'isDelivered') &&
        isOptionalBool(data, 'isEdited') &&
        isOptionalTimestamp(data, 'editedAt') &&
        isOptionalTimestamp(data, 'seenAt') &&
        isOptionalString(data, 'replyToId', 0, 128) &&
        isOptionalString(data, 'replyToText', 0, 500) &&
        isOptionalString(data, 'replyToSenderName', 0, 120) &&
        (!('createdAtMs' in data) || data.createdAtMs is int) &&
        isOptionalTimestamp(data, 'timestamp');
    }

    function isValidChatMessageUpdate() {
      let prev = resource.data;
      let next = request.resource.data;
      let unseen = prev.get('isSeen', false) != true && !(prev.get('status', '') in ['seen', 'read']);

      let senderEdit =
        prev.senderId == request.auth.uid &&
        unseen &&
        prev.type != 'audio' &&
        next.diff(prev).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt']) &&
        isValidString(next.text, 1, 2000) &&
        next.isEdited == true &&
        isOptionalTimestamp(next, 'editedAt');

      let senderAttachRemoteAudioUrl =
        prev.senderId == request.auth.uid &&
        prev.type == 'audio' &&
        next.diff(prev).affectedKeys().hasOnly(['audioUrl']) &&
        isValidUrl(next.audioUrl) &&
        next.audioUrl.size() <= 1000 &&
        !(prev.get('audioUrl', '').matches("^https://.*"));

      let recipientMarkSeen =
        prev.senderId != request.auth.uid &&
        next.diff(prev).affectedKeys().hasOnly(['isSeen', 'status', 'seenAt']) &&
        next.isSeen is bool &&
        next.status in ['seen', 'read'] &&
        isOptionalTimestamp(next, 'seenAt');

      return senderEdit || senderAttachRemoteAudioUrl || recipientMarkSeen;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // 1. Drivers Primary Profiles & Subcollections
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow create: if (
        isOwner(driverId) &&
        isValidDriverDocument(request.resource.data, driverId, false) &&
        isValidDriverCreateState(request.resource.data)
      ) || (
        (isSuperAdmin() || hasAdminScreen('drivers') || hasAdminScreen('transporters')) &&
        isValidDriverDocument(request.resource.data, driverId, true)
      );
      allow update: if (
        isOwner(driverId) && (
          isValidSafeProfileSelfUpdate() ||
          (
            isValidDriverUpdateState(driverId) &&
            isValidDriverChangedFields(driverId)
          ) ||
          isValidSelfAccountDeletionArchive()
        )
      ) || (
        (isSuperAdmin() || hasAdminScreen('drivers') || hasAdminScreen('transporters') || hasAdminScreen('bookings') || hasAdminScreen('financials')) &&
        isValidAdminDriverUpdate()
      ) || isAdmin();
      allow delete: if isSuperAdmin() || hasAdminScreen('drivers') || hasAdminScreen('transporters');

      match /trucks/{truckId} {
        allow read: if isOwner(driverId) || isAdmin();
        allow create: if isBusinessFleetOwner(driverId) &&
          isValidFleetTruck(request.resource.data, driverId);
        allow update: if isBusinessFleetOwner(driverId) &&
          isValidFleetTruck(request.resource.data, driverId) &&
          areImmutableFieldsUnchanged(['id', 'companyId', 'createdAt']);
        allow delete: if isBusinessFleetOwner(driverId) &&
          resource.data.get('status', 'available') != 'on_trip';
      }

      match /fleet_drivers/{fleetDriverId} {
        allow read: if isOwner(driverId) || isAdmin();
        allow create: if isBusinessFleetOwner(driverId) &&
          isValidFleetDriver(request.resource.data, driverId);
        allow update: if isBusinessFleetOwner(driverId) &&
          isValidFleetDriver(request.resource.data, driverId) &&
          areImmutableFieldsUnchanged(['id', 'companyId', 'createdAt']);
        allow delete: if isBusinessFleetOwner(driverId) &&
          resource.data.get('status', 'available') != 'on_trip';
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(driverId) || isAdmin();
        allow create: if isAuthenticated() &&
          isValidNotification(request.resource.data);
        allow update: if isOwner(driverId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
          request.resource.data.isRead is bool;
        allow delete: if isOwner(driverId);
      }

      match /payment_methods/{paymentId} {
        allow read: if isOwner(driverId) || isAdmin();
        allow create: if isOwner(driverId) &&
          isValidPaymentMethod(request.resource.data);
        allow update: if isOwner(driverId) &&
          isValidPaymentMethod(request.resource.data) &&
          areImmutableFieldsUnchanged(['createdAt']);
        allow delete: if isOwner(driverId);
      }

      match /transactions/{txId} {
        allow read: if isOwner(driverId) || isAdmin();
        allow create: if (
          isOwner(driverId) && (
            isValidTripEarningsTx(request.resource.data, txId) ||
            isValidDriverCommissionSettlementTx(request.resource.data, txId)
          )
        ) || (
          (isSuperAdmin() || hasAdminScreen('financials')) &&
          isValidAdminCommissionSettlementTx(request.resource.data, txId)
        );
        allow update, delete: if false;
      }

      match /cancelled_trips/{cancelId} {
        allow read: if isOwner(driverId) || isAdmin();
        allow create: if isOwner(driverId) &&
          isValidCancelledTrip(request.resource.data, cancelId);
        allow update, delete: if false;
      }
    }

    // 1a. CollectionGroup('transactions') read access for Admin Panel Financials & Dashboard
    match /{path=**}/transactions/{txId} {
      allow read: if isAdmin();
    }

    // 1b. Public Non-PII Driver Telemetry (Safe for Shipper Home Map)
    match /drivers_public/{driverId} {
      allow read: if isAuthenticated();
      allow create, update: if (
        isOwner(driverId) &&
        isValidDriverPublicDoc(request.resource.data, driverId)
      ) || (
        (isSuperAdmin() || hasAdminScreen('drivers') || hasAdminScreen('transporters') || hasAdminScreen('bookings')) &&
        isValidDriverPublicDoc(request.resource.data, driverId)
      ) || isAdmin();
      allow delete: if isOwner(driverId) || isSuperAdmin() || hasAdminScreen('drivers') || hasAdminScreen('transporters') || isAdmin();
    }

    // 2. Users Collection (Shippers, Business Shippers, Driver Mirrors, & Admin Staff) & Subcollections
    match /Users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if (
        isOwner(userId) &&
        !isAdminAccountData(request.resource.data) && (
          (
            request.resource.data.get('role', '') in ['driver', 'business_driver'] &&
            isValidDriverDocument(request.resource.data, userId, true) &&
            isValidDriverCreateState(request.resource.data)
          ) ||
          (
            isValidNonDriverUserDoc(request.resource.data, userId) &&
            isValidNonDriverUserCreateState(request.resource.data)
          )
        )
      ) || (
        isSuperAdmin() &&
        isAdminAccountData(request.resource.data) &&
        isValidAdminAccountCreate(request.resource.data, userId)
      ) || (
        (isSuperAdmin() || hasAdminScreen('users') || hasAdminScreen('agencies') || hasAdminScreen('drivers') || hasAdminScreen('transporters')) &&
        isValidAdminUserCreate(request.resource.data, userId)
      ) || isAdmin();

      allow update: if (
        // Safe self-update fast-path (profile photo, FCM token, presence, notification prefs)
        // Allowed for any authenticated owner (shipper, driver, or admin) with zero privilege-escalation surface
        isOwner(userId) && isValidSafeProfileSelfUpdate()
      ) || (
        isOwner(userId) &&
        !isAdminAccountData(resource.data) &&
        !isAdminAccountData(request.resource.data) &&
        (
          (
            (
              resource.data.get('role', '') in ['driver', 'business_driver'] ||
              (
                resource.data.get('role', '') == '' &&
                exists(/databases/$(database)/documents/drivers/$(userId))
              )
            )
              ? (isValidDriverUpdateState(userId) && isValidDriverChangedFields(userId))
              : (isValidNonDriverUserUpdateState(userId) && isValidNonDriverUserChangedFields(userId))
          ) ||
          isValidSelfAccountDeletionArchive()
        )
      ) || (
        isSuperAdmin() &&
        (isAdminAccountData(resource.data) || isAdminAccountData(request.resource.data)) &&
        isValidAdminAccountUpdate(userId)
      ) || (
        (isSuperAdmin() || hasAdminScreen('users') || hasAdminScreen('agencies') || hasAdminScreen('drivers') || hasAdminScreen('transporters') || hasAdminScreen('bookings')) &&
        isValidAdminUserUpdate()
      );

      allow delete: if userId != request.auth.uid && (
        (isSuperAdmin() && isAdminAccountData(resource.data)) ||
        (!isAdminAccountData(resource.data) && (isSuperAdmin() || hasAdminScreen('users') || hasAdminScreen('agencies') || hasAdminScreen('drivers') || hasAdminScreen('transporters')))
      );

      // Shipper Saved Addresses
      match /Addresses/{addressId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          isValidUserAddress(request.resource.data);
        allow update: if isOwner(userId) &&
          isValidUserAddress(request.resource.data) &&
          areImmutableFieldsUnchanged(['dateTime']);
        allow delete: if isOwner(userId);
      }

      // Shipper Notifications
      match /Notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated() &&
          isValidUserNotification(request.resource.data);
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
          request.resource.data.isRead is bool;
        allow delete: if isOwner(userId);
      }

      // Shipper Saved Payment Methods & Card Authorizations
      match /PaymentDetails/{paymentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          isValidPaymentMethod(request.resource.data);
        allow update: if isOwner(userId) &&
          isValidPaymentMethod(request.resource.data) &&
          areImmutableFieldsUnchanged(['createdAt', 'authorizationCode', 'last4', 'brand', 'expMonth', 'expYear', 'method']);
        allow delete: if isOwner(userId);
      }

      // Shipper Refund Ledger (Written by Cloud Functions via Admin SDK ONLY)
      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // 3. Lowercase users & Sellers (Strictly owner-only to prevent PII leaks)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /Sellers/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if false;
    }

    // 4. Bookings Pool & Active Trips
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        isAssignedDriverOrCompany(resource.data) ||
        (isBookingOpenStatus(resource.data) && isEligibleVerifiedDriver()) ||
        isAdmin()
      );

      // Verified & admin-approved shippers (or Admins) can create bookings in unpaid pending state
      allow create: if isAuthenticated() &&
        (isEligibleVerifiedShipper() || isAdmin()) &&
        isValidShipperBookingCreate(request.resource.data);

      // Shipper docs/edits/cancel/verified-payment-sync OR Driver operational transitions OR Authorized Admin
      allow update: if isAuthenticated() && (
        isValidShipperBookingDocumentsUpdate() ||
        isValidShipperBookingEdit() ||
        isValidShipperBookingCancel() ||
        isValidShipperBookingPaymentMirror(bookingId) ||
        isValidBookingAcceptance() ||
        isValidBookingLocationUpdate() ||
        isValidSequentialStageTransition() ||
        isValidDriverCancellation() ||
        (
          (isSuperAdmin() || hasAdminScreen('bookings') || hasAdminScreen('fleet_map') || hasAdminScreen('support') || hasAdminScreen('financials')) &&
          isValidAdminBookingUpdate()
        ) ||
        isAdmin()
      );

      allow delete: if isSuperAdmin() || isAdmin();

      // Trip Chat Sessions & Messages
      match /chats/{chatSessionId} {
        allow read: if isBookingParticipant(bookingId);
        allow create, update: if isBookingParticipant(bookingId) &&
          isBookingChatUnlocked(bookingId) &&
          hasOnlyAllowedFields(request.resource.data, [
            'driverId', 'driverName', 'shipperId', 'shipperName',
            'chatSessionId', 'bookingId', 'lastMessage', 'lastSenderRole',
            'lastUpdated', 'createdAtMs',
            'shipperTyping', 'shipperTypingUpdatedAt',
            'driverTyping', 'driverTypingUpdatedAt'
          ]) &&
          isOptionalString(request.resource.data, 'driverId', 0, 128) &&
          isOptionalString(request.resource.data, 'driverName', 0, 120) &&
          isOptionalString(request.resource.data, 'shipperId', 0, 128) &&
          isOptionalString(request.resource.data, 'shipperName', 0, 120) &&
          isOptionalString(request.resource.data, 'chatSessionId', 0, 160) &&
          isOptionalString(request.resource.data, 'bookingId', 0, 128) &&
          isOptionalString(request.resource.data, 'lastMessage', 0, 2000) &&
          isOptionalString(request.resource.data, 'lastSenderRole', 0, 40) &&
          isOptionalBool(request.resource.data, 'shipperTyping') &&
          isOptionalTimestamp(request.resource.data, 'shipperTypingUpdatedAt') &&
          isOptionalBool(request.resource.data, 'driverTyping') &&
          isOptionalTimestamp(request.resource.data, 'driverTypingUpdatedAt') &&
          (!('createdAtMs' in request.resource.data) || request.resource.data.createdAtMs is int) &&
          isOptionalTimestamp(request.resource.data, 'lastUpdated');
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isBookingParticipant(bookingId);
          allow create: if isBookingParticipant(bookingId) &&
            isBookingChatUnlocked(bookingId) &&
            isValidChatMessageCreate(request.resource.data);
          allow update: if isBookingParticipant(bookingId) &&
            isBookingChatUnlocked(bookingId) &&
            isValidChatMessageUpdate();
          allow delete: if isBookingParticipant(bookingId) &&
            isBookingChatUnlocked(bookingId) &&
            resource.data.senderId == request.auth.uid &&
            resource.data.get('isSeen', false) != true &&
            !(resource.data.get('status', '') in ['seen', 'read']);
        }
      }

      // Compatibility root messages subcollection
      match /messages/{messageId} {
        allow read: if isBookingParticipant(bookingId);
        allow create: if isBookingParticipant(bookingId) &&
          isBookingChatUnlocked(bookingId) &&
          isValidChatMessageCreate(request.resource.data);
        allow update: if isBookingParticipant(bookingId) &&
          isBookingChatUnlocked(bookingId) &&
          isValidChatMessageUpdate();
        allow delete: if isBookingParticipant(bookingId) &&
          isBookingChatUnlocked(bookingId) &&
          resource.data.senderId == request.auth.uid &&
          resource.data.get('isSeen', false) != true &&
          !(resource.data.get('status', '') in ['seen', 'read']);
      }
    }

    // 4b. Top-level Admin Cancelled Trips Audit Log
    match /cancelled_trips/{cancelId} {
      allow read: if isAdmin();
      allow create: if (isSuperAdmin() || hasAdminScreen('bookings') || hasAdminScreen('fleet_map') || hasAdminScreen('support')) &&
        isValidAdminCancelledTrip(request.resource.data);
      allow update, delete: if false;
    }

    // 5. Banners & Sequential ID Counters
    match /Banners/{bannerId} {
      allow read: if isAuthenticated() && (resource.data.get('active', false) == true || isAdmin());
      allow create: if (isSuperAdmin() || hasAdminScreen('banners')) &&
        isValidBannerCreate(request.resource.data);
      allow update: if (isSuperAdmin() || hasAdminScreen('banners')) &&
        isValidBannerUpdate();
      allow delete: if isSuperAdmin() || hasAdminScreen('banners');
    }

    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        hasOnlyAllowedFields(request.resource.data, ['lastNumber', 'updatedAt']) &&
        request.resource.data.lastNumber == 1 &&
        isOptionalTimestamp(request.resource.data, 'updatedAt');
      allow update: if isAuthenticated() &&
        hasOnlyAllowedFields(request.resource.data, ['lastNumber', 'updatedAt']) &&
        request.resource.data.lastNumber is int &&
        resource.data.lastNumber is int &&
        request.resource.data.lastNumber == resource.data.lastNumber + 1 &&
        isOptionalTimestamp(request.resource.data, 'updatedAt');
      allow delete: if false;
    }

    // 6. Public/App Configuration & Strictly Gated Gateway Secrets
    match /app_settings/pricing_config {
      allow read: if isAuthenticated();
      allow write: if (isSuperAdmin() || hasAdminScreen('pricing')) &&
        isValidPricingConfig(request.resource.data);
    }

    match /app_settings/support_config {
      allow read: if isAuthenticated();
      allow write: if (isSuperAdmin() || hasAdminScreen('support') || hasAdminComponent('settings.support_card')) &&
        isValidSupportConfig(request.resource.data);
    }

    match /app_settings/geofence_config {
      allow read: if isAuthenticated();
      allow write: if (isSuperAdmin() || hasAdminComponent('settings.geofence_card')) &&
        isValidGeofenceConfig(request.resource.data);
    }

    // Paystack Gateway & API Keys: STRICTLY Super Admin / settings.paystack_card ONLY!
    match /app_settings/payment_gateway {
      allow read: if isSuperAdmin() || hasAdminComponent('settings.paystack_card');
      allow write: if (isSuperAdmin() || hasAdminComponent('settings.paystack_card')) &&
        isValidPaystackGatewayConfig(request.resource.data);
    }

    // Block client access to didit_settings (API/webhook secrets), email_2fa, and any other config docs
    match /app_settings/{otherDoc} {
      allow read, write: if false;
      match /{sub=**} {
        allow read, write: if false;
      }
    }

    match /payment_gateway/{docId} {
      allow read, write: if false;
    }

    match /Settings/{settingId} {
      allow read, write: if false;
    }

    // 7. Didit Webhook Audit Collections & Admin 2FA Internals (Admin SDK / Cloud Functions ONLY)
    match /DiditWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /DiditWebhookLogs/{logId} {
      allow read, write: if false;
    }

    match /admin_2fa_secrets/{secretId} {
      allow read, write: if false;
    }

    match /admin_2fa_challenges/{challengeId} {
      allow read, write: if false;
    }

    match /server_internal/{docId} {
      allow read, write: if false;
    }

    // 8. Payments Collection (Paystack Cloud Functions via Admin SDK + Admin manual commission_settlement)
    match /Payments/{reference} {
      allow read: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create: if (isSuperAdmin() || hasAdminScreen('financials')) &&
        isValidAdminCommissionPayment(request.resource.data, reference);
      allow update, delete: if false;
    }

    // 9. Support Tickets (Both Shippers & Drivers + Support Admin)
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.get('driverId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && isValidSupportTicket(request.resource.data);
      allow update: if (isSuperAdmin() || hasAdminScreen('support')) &&
        isValidAdminSupportTicketUpdate();
      allow delete: if isSuperAdmin();
    }

    // 10. Account Deletion Requests (Both Shippers & Drivers + Admin Review)
    match /account_deletion_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.get('driverId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && isValidAccountDeletionRequest(request.resource.data);
      allow update: if (isSuperAdmin() || hasAdminScreen('users') || hasAdminScreen('agencies') || hasAdminScreen('drivers') || hasAdminScreen('transporters')) &&
        isValidAdminDeletionRequestUpdate();
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // Default Deny Everything Else
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
