        (!changed.hasAny(['adminApproved']) || isOptionalBool(next, 'adminApproved')) &&
        (!changed.hasAny(['adminRejectionReason']) || isOptionalString(next, 'adminRejectionReason', 0, 500)) &&
        (!changed.hasAny(['adminApprovalDate']) || isOptionalTimestampOrDateString(next, 'adminApprovalDate')) &&
        (!changed.hasAny(['commissionOwed']) || isOptionalNum(next, 'commissionOwed', 0, 10000000)) &&
        (!changed.hasAny(['totalCommissionPaid']) || isOptionalNum(next, 'totalCommissionPaid', 0, 100000000)) &&
        (!changed.hasAny(['isCommissionBlocked']) || isOptionalBool(next, 'isCommissionBlocked')) &&
        (!changed.hasAny(['lastSettledAt']) || isOptionalTimestamp(next, 'lastSettledAt')) &&
        (!changed.hasAny(['firstName']) || isOptionalString(next, 'firstName', 0, 80)) &&
        (!changed.hasAny(['lastName']) || isOptionalString(next, 'lastName', 0, 80)) &&
        (!changed.hasAny(['phoneNumber']) || isOptionalString(next, 'phoneNumber', 0, 30)) &&
        (!changed.hasAny(['vehicleType']) || isOptionalString(next, 'vehicleType', 0, 80)) &&
        (!changed.hasAny(['vehicleModel']) || isOptionalString(next, 'vehicleModel', 0, 120)) &&
