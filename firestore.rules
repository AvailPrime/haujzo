    function isValidDriverPublicDoc(data, driverId) {
      return hasOnlyAllowedFields(data, [
          'id', 'driverId', 'vehicleType', 'vehicleModel', 'licensePlate',
          'status', 'isOnline', 'currentLocation', 'heading', 'bearing',
          'rating', 'completedTrips', 'lastSeen', 'updatedAt'
        ]) &&
        hasRequiredFields(data, ['status']) &&
        data.get('id', driverId) == driverId &&
        data.get('driverId', driverId) == driverId &&
        data.status in ['online', 'offline', 'busy', 'suspended'] &&
