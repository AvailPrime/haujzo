    function isValidDriverCommissionChange(prev, next) {
      let prevOwed = (prev.get('commissionOwed', 0) is number) ? prev.get('commissionOwed', 0) : 0;
      let nextOwed = (next.get('commissionOwed', 0) is number) ? next.get('commissionOwed', 0) : 0;
      let prevPaid = (prev.get('totalCommissionPaid', 0) is number) ? prev.get('totalCommissionPaid', 0) : 0;
      let nextPaid = (next.get('totalCommissionPaid', 0) is number) ? next.get('totalCommissionPaid', 0) : 0;
      let isAccrual = nextOwed >= prevOwed && nextPaid == prevPaid &&
        (nextOwed <= 0.005 || next.get('isCommissionBlocked', false) == true);
      let isSettlement = nextPaid > prevPaid && nextOwed >= 0 &&
        (prevOwed - nextOwed) <= (nextPaid - prevPaid) + 0.05 &&
        (nextOwed <= 0.005 || next.get('isCommissionBlocked', false) == true);
      return isAccrual || isSettlement;
    }

    function isValidDriverDiditChange(prev, next) {
      return (next.get('diditVerified', false) != true || prev.get('diditVerified', false) == true) &&
        (next.get('isVerified', false) != true || prev.get('isVerified', false) == true) &&
        (!(next.get('verificationStatus', 'unverified') in ['approved', 'Approved', 'APPROVED']) || (prev.get('verificationStatus', 'unverified') in ['approved', 'Approved', 'APPROVED'])) &&
        (!(next.get('verification_status', 'unverified') in ['approved', 'Approved', 'APPROVED']) || (prev.get('verification_status', 'unverified') in ['approved', 'Approved', 'APPROVED'])) &&
        (!(next.get('diditStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED']) || (prev.get('diditStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED'])) &&
        (!(next.get('kycStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED']) || (prev.get('kycStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED'])) &&
        (!(next.get('kybStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED']) || (prev.get('kybStatus', 'Not Started') in ['Approved', 'approved', 'APPROVED']));
    }

    function isValidDriverUpdateState(docId) {
      let prev = resource.data;
      let next = request.resource.data;
      let changed = next.diff(prev).affectedKeys();
      let adminImmutable = [
        'adminApprovalStatus', 'adminApproved', 'adminApprovalDate', 'adminApprovedAt', 'adminRejectionReason',
        'approvedBy', 'updatedBy',
        'rating', 'diditDecision',
        'kybVerified', 'kycVerified',
        'kybAdminApprovalStatus', 'kybAdminApproved', 'kybAdminApprovalDate', 'kybAdminRejectionReason',
        'kycAdminApprovalStatus', 'kycAdminApproved', 'kycAdminApprovalDate', 'kycAdminRejectionReason',
        'createdAt'
      ];
      return !changed.hasAny(adminImmutable) &&
        (!('id' in changed) || (!('id' in prev) && next.id == docId)) &&
        (!('role' in changed) || next.get('role', 'driver') == prev.get('role', 'driver') || next.get('role', '') in ['driver', 'business_driver']) &&
        (!changed.hasAny(['diditVerified', 'isVerified', 'verificationStatus', 'verification_status', 'diditStatus', 'kycStatus', 'kybStatus']) || isValidDriverDiditChange(prev, next)) &&
        (!changed.hasAny(['commissionOwed', 'totalCommissionPaid', 'isCommissionBlocked']) || isValidDriverCommissionChange(prev, next)) &&
        (
          !('status' in changed) || (
            (prev.get('status', 'offline') != 'suspended' || next.get('status', 'offline') == 'suspended') &&
            (next.get('status', 'offline') != 'suspended' || prev.get('status', 'offline') == 'suspended') &&
            (next.get('status', 'offline') != 'online' || prev.get('status', 'offline') == 'online' || isEligibleVerifiedDriver())
          )
        ) &&
        (!('deletionRequested' in changed) || prev.get('deletionRequested', false) != true || next.get('deletionRequested', false) == true);
    }

    function isValidSelfAccountDeletionArchive() {
      let prev = resource.data;
