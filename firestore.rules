        (!('profilePicture' in changed) || next.get('profilePicture', null) == null || next.get('profilePicture', '') == '' || (isValidUrl(next.profilePicture) && next.profilePicture.size() <= 2048)) &&
        (!('ProfilePicture' in changed) || next.get('ProfilePicture', null) == null || next.get('ProfilePicture', '') == '' || (isValidUrl(next.ProfilePicture) && next.ProfilePicture.size() <= 2048)) &&
        (!('vehicleType' in changed) || isOptionalString(next, 'vehicleType', 0, 80)) &&
        (!('truckType' in changed) || isOptionalString(next, 'truckType', 0, 80)) &&
        (!('vehicleModel' in changed) || isOptionalString(next, 'vehicleModel', 0, 120)) &&
        (!('licensePlate' in changed) || isOptionalString(next, 'licensePlate', 0, 40)) &&
        (!('licenseNumber' in changed) || isOptionalString(next, 'licenseNumber', 0, 60)) &&
