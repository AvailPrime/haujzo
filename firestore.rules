    function isValidNonDriverUserCreateState(data) {
      return data.get('status', 'active') in ['online', 'offline', 'busy', 'active'] &&
        data.get('diditVerified', false) == false &&
        data.get('isVerified', false) == false &&
        data.get('kycVerified', false) == false &&
        data.get('kybVerified', false) == false &&
        data.get('verificationStatus', 'unverified') in ['unverified', 'pending'] &&
        data.get('adminApprovalStatus', 'pending') == 'pending' &&
        data.get('adminApproved', false) == false &&
        data.get('kycAdminApprovalStatus', 'pending') == 'pending' &&
        data.get('kycAdminApproved', false) == false &&
        data.get('kybAdminApprovalStatus', 'pending') == 'pending' &&
        data.get('kybAdminApproved', false) == false &&
        data.get('deletionRequested', false) == false &&
        !('diditDecision' in data);
