    function isValidAdminPermissionsMap(perms) {
      return perms is map &&
        hasOnlyAllowedFields(perms, ['isFullAccess', 'screens', 'components']) &&
        isOptionalBool(perms, 'isFullAccess') &&
        (!('screens' in perms) || (perms.screens is list && perms.screens.size() <= 50)) &&
        (!('components' in perms) || (perms.components is list && perms.components.size() <= 150));
    }

    function isValidNonDriverUserDoc(data, docId) {
      return hasOnlyAllowedFields(data, allowedNonDriverUserKeys()) &&
        data.get('id', docId) == docId &&
        data.get('role', 'shipper') in ['user', 'client', 'shipper', 'owner', 'business_shipper', 'agent', 'driver', 'business_driver'] &&
        data.get('accountType', 'individual') in ['individual', 'business'] &&
