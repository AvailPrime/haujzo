      let changed = next.diff(prev).affectedKeys();
      let prevOwed = (prev.get('commissionOwed', 0) is number) ? prev.get('commissionOwed', 0) : 0;
      return prevOwed <= 0.005 &&
        changed.hasOnly([
          'status', 'isOnline', 'deletionRequested', 'deletionRequestedAt',
          'currentLocation', 'fcmToken', 'deviceToken',
          'profilePicture', 'ProfilePicture', 'updatedAt', 'lastUpdated'
        ]) &&
        next.get('status', 'offline') == 'offline' &&
        next.get('isOnline', false) == false &&
        next.get('deletionRequested', false) == true &&
        isOptionalTimestamp(next, 'deletionRequestedAt') &&
        (!('currentLocation' in next) || next.currentLocation == null) &&
        isOptionalString(next, 'fcmToken', 0, 500) &&
        isOptionalString(next, 'deviceToken', 0, 500) &&
        (!('profilePicture' in next) || next.profilePicture == null || next.profilePicture == '') &&
        (!('ProfilePicture' in next) || next.ProfilePicture == null || next.ProfilePicture == '') &&
