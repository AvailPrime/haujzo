        (!('Email' in data) || data.Email == null || data.Email == '' || isValidEmail(data.Email)) &&
        isOptionalString(data, 'phoneNumber', 0, 30) &&
        isOptionalString(data, 'PhoneNumber', 0, 30) &&
        (
          !('profilePicture' in data) || data.profilePicture == null ||
          data.profilePicture == '' ||
          (isValidUrl(data.profilePicture) && data.profilePicture.size() <= 2048)
        ) &&
        (
          !('ProfilePicture' in data) || data.ProfilePicture == null ||
          data.ProfilePicture == '' ||
          (isValidUrl(data.ProfilePicture) && data.ProfilePicture.size() <= 2048)
        ) &&
        isOptionalString(data, 'gender', 0, 30) &&
        isOptionalString(data, 'dateOfBirth', 0, 30) &&
        isOptionalString(data, 'country', 0, 80) &&
        isOptionalString(data, 'countryCode', 0, 15) &&
        isOptionalBool(data, 'allowDataUsage') &&
        isOptionalString(data, 'fcmToken', 0, 500) &&
        isOptionalString(data, 'deviceToken', 0, 500) &&
        isOptionalString(data, 'defaultAddressId', 0, 128) &&
        (!('notificationPreferences' in data) || isValidNotificationPreferences(data.notificationPreferences)) &&
        isOptionalString(data, 'vehicleType', 0, 80) &&
        isOptionalString(data, 'vehicleModel', 0, 120) &&
        isOptionalString(data, 'licensePlate', 0, 40) &&
        (!('currentLocation' in data) || data.currentLocation == null || data.currentLocation is latlng) &&
        isOptionalString(data, 'companyName', 0, 150) &&
        isOptionalString(data, 'registrationNumber', 0, 80) &&
        isOptionalString(data, 'businessRegistrationNumber', 0, 80) &&
        isOptionalString(data, 'taxNumber', 0, 80) &&
        isOptionalString(data, 'businessAddress', 0, 300) &&
        isOptionalString(data, 'idDocumentType', 0, 50) &&
        isOptionalString(data, 'idDocumentName', 0, 120) &&
        isOptionalString(data, 'idDocumentNumber', 0, 60) &&
        isOptionalString(data, 'idDocumentExpiry', 0, 30) &&
        isOptionalBool(data, 'kycFormSubmitted') &&
        isOptionalBool(data, 'kybFormSubmitted') &&
        isOptionalBool(data, 'kycVerified') &&
        isOptionalString(data, 'kycStatus', 0, 50) &&
        isOptionalString(data, 'kycSessionId', 0, 150) &&
        isOptionalString(data, 'kycAdminApprovalStatus', 0, 50) &&
        isOptionalBool(data, 'kycAdminApproved') &&
        isOptionalString(data, 'kycAdminRejectionReason', 0, 500) &&
        isOptionalTimestampOrDateString(data, 'kycAdminApprovalDate') &&
        isOptionalBool(data, 'kybVerified') &&
        isOptionalString(data, 'kybStatus', 0, 50) &&
        isOptionalString(data, 'kybSessionId', 0, 150) &&
        isOptionalString(data, 'kybAdminApprovalStatus', 0, 50) &&
        isOptionalBool(data, 'kybAdminApproved') &&
        isOptionalString(data, 'kybAdminRejectionReason', 0, 500) &&
        isOptionalTimestampOrDateString(data, 'kybAdminApprovalDate') &&
        isOptionalString(data, 'verificationStatus', 0, 50) &&
        isOptionalString(data, 'verification_status', 0, 50) &&
        (!('verificationType' in data) || data.verificationType in ['none', 'kyc', 'kyb']) &&
        isOptionalString(data, 'diditRequestId', 0, 150) &&
        isOptionalString(data, 'diditSessionId', 0, 150) &&
        isOptionalString(data, 'diditBusinessSessionId', 0, 150) &&
        isOptionalString(data, 'diditVendorData', 0, 150) &&
        isOptionalString(data, 'diditSessionKind', 0, 50) &&
        isOptionalString(data, 'diditWebhookType', 0, 100) &&
        isOptionalString(data, 'diditStatus', 0, 50) &&
        isOptionalBool(data, 'diditVerified') &&
        isOptionalBool(data, 'isVerified') &&
        isOptionalTimestampOrDateString(data, 'verifiedAt') &&
        isOptionalString(data, 'rejectionReason', 0, 500) &&
